{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npm run -s main:al-dia -- --aplicar 2>&1 | tail -n 5 || true",
            "timeout": 60,
            "statusMessage": "Poniendo main al día con origin/main…"
          },
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && npm run -s mac:carga -- --breve 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Mirando la carga de la Mac…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/frenar-git-que-barre.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "andrej-karpathy-skills@karpathy-skills": true
  },
  "permissions": {
    "allow": [
      "Bash(gh secret set *)"
    ]
  }
}
