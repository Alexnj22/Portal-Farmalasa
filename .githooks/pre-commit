#!/bin/sh
# Hook de pre-commit del portal. Versionado a propósito: `.git/hooks/` no viaja
# con el repo, así que un clon nuevo (u otra máquina) se quedaría sin gate.
# Se habilita con `npm run hooks:install` (setea core.hooksPath=.githooks).
#
# Hace tres cosas, todas baratas — ningún chequeo que necesite red:
#
#   1. CONCURRENCIA. Hay varias sesiones de Claude trabajando sobre este mismo
#      árbol al mismo tiempo (medido: el `git status` de una sesión pasó de 2 a 8
#      archivos modificados en 40 minutos, sin que esa sesión tocara los 6
#      nuevos). Si un archivo está preparado Y además modificado después, el
#      commit se estaría llevando una foto parcial de algo que alguien más sigue
#      editando. Se bloquea.
#   2. `version-gate.mjs` — APP_VERSION tiene que subir si cambió `src/`
#      (regla de CLAUDE.md; doce bumps habían fallado en silencio antes de que
#      existiera el gate).
#   3. `migration-gate.mjs` — solo si el commit toca migraciones. Se corre
#      acotado a eso justamente para no bloquear a una sesión por el árbol a
#      medio editar de otra.
#
# `git commit --no-verify` lo saltea. Es para una emergencia real, no para
# silenciar un hallazgo: los tres chequeos son consecuencia de incidentes.

echo ""

# ── 1. ¿Alguien más está editando lo que estoy por commitear? ───────────────────
# Formato de --porcelain: "XY ruta", X = índice, Y = árbol de trabajo.
# X≠' ' y X≠'?'  → preparado.   Y≠' '  → cambió después de prepararlo.
CONCURRENTES=$(git status --porcelain | awk '
  { x = substr($0,1,1); y = substr($0,2,1)
    if (x != " " && x != "?" && y != " ") print substr($0,4) }')

if [ -n "$CONCURRENTES" ]; then
  echo "  ✗ Archivo(s) preparados y modificados DESPUÉS de prepararlos:"
  echo ""
  echo "$CONCURRENTES" | sed 's/^/      /'
  echo ""
  echo "    El commit se llevaría una versión que ya no es la del disco. En este"
  echo "    repo trabajan varias sesiones a la vez, así que ese cambio de más"
  echo "    puede no ser tuyo."
  echo ""
  echo "    Si el cambio es tuyo:  git add <archivo>   (y volvé a commitear)"
  echo "    Si NO es tuyo:         git restore --staged <archivo>   — dejalo afuera,"
  echo "                           no lo pises ni lo revertás."
  echo ""
  exit 1
fi

# ── 2. Lo que queda fuera del commit, a la vista ────────────────────────────────
# Informativo, no bloquea: es para no asumir nunca un árbol limpio.
FUERA=$(git status --porcelain | awk '
  { x = substr($0,1,1); y = substr($0,2,1)
    if ((x == " " && y != " ") || x == "?") print substr($0,4) }')

if [ -n "$FUERA" ]; then
  N=$(echo "$FUERA" | wc -l | tr -d ' ')
  echo "  ℹ $N archivo(s) modificados FUERA de este commit (posiblemente de otra sesión):"
  echo "$FUERA" | head -8 | sed 's/^/      /'
  [ "$N" -gt 8 ] && echo "      … y $((N - 8)) más"
  echo "    No los toques, no los revertás, no los commitees de arrastre."
  echo ""
fi

# ── 3. Los gates ────────────────────────────────────────────────────────────────
node scripts/version-gate.mjs || exit 1

if git diff --cached --name-only | grep -q '^supabase/migrations'; then
  node scripts/migration-gate.mjs --hook || exit 1
fi

# data-gate: sólo si el commit toca código que habla con la base. Es local y
# sin red, así que corre en ~1s. (Auditoría 2026-07-30 — cap de 1000, tipos
# booleanos, errores tragados.)
#
# `--hook` lo acota a lo que el ÍNDICE conoce. Hasta el 2026-08-01 este
# comentario decía que estaba "acotado al diff preparado […] para no bloquear a
# esta sesión por el árbol a medio editar de otra", pero lo único acotado era el
# `if` de acá abajo: el gate escaneaba el disco entero, archivos sin trackear
# incluidos. Con 2-3 sesiones sobre el mismo árbol eso significa que una no
# puede commitear hasta que otra termine, y el mensaje culpa a un archivo que
# quien commitea nunca tocó. La intención estaba escrita y no implementada; el
# flag la implementa.
if git diff --cached --name-only | grep -qE '^(src/|supabase/functions/)'; then
  node scripts/data-gate.mjs --hook || exit 1
fi

# permissions-gate: solo si el commit toca el registro de permisos o código que
# los consulta. Cruza lo declarado en Permisos contra lo que el código realmente
# gatea (por sus cinco caminos: literal, plantilla, variable, indirecta y guard
# de ruta). Existe porque la auditoría del 2026-08-03 encontró a mano un permiso
# de "datos sensibles" que no consultaba nadie, un módulo que no se podía
# repartir, y un rename que dejó a la vista consultando la clave vieja.
# Local, sin red, ~200ms. `--hook` lo acota al ÍNDICE, no al disco.
if git diff --cached --name-only | grep -qE '^src/'; then
  node scripts/permissions-gate.mjs --hook || exit 1
fi

# mobile-gate: solo si el commit toca vistas o componentes. Detecta que alguien
# volvió a escribir a mano un elemento que ya tiene variante móvil canónica —una
# `<table>` propia, un `ModalShell` sin cuerpo, un buscador duplicado—, que es lo
# único de las tres capas del canon móvil que se puede ver SIN ejecutar la app.
# Lo demás (desborde, blancos de 44pt, caída a tabla) lo mide el barrido de
# Playwright, que no puede vivir en un hook. Canon: DESIGN.md §32.
# Local, sin red. `--hook` lo acota al ÍNDICE, no al disco.
if git diff --cached --name-only | grep -qE '^src/(views|components)/'; then
  node scripts/mobile-gate.mjs --hook || exit 1
fi

# perf-gate: sólo si el commit toca los tres archivos donde vive lo que evita
# que la Consulta de Inventario se vuelva a trabar — el largo mínimo de la
# búsqueda, el techo de productos y el filtro que le da índice al selector de
# sucursal. `--hook` corre SÓLO esos chequeos: son locales e instantáneos.
# El resto del gate (índices, forma del plan y tiempos) habla con producción y
# va antes de cerrar, junto a gate:design — un gate de commit que necesita red
# falla sin conexión y enseña a usar --no-verify.
if git diff --cached --name-only | grep -qE '^src/(data/(inventory|inventarioTab)\.js|views/dashboard/WidgetInventorySearch\.jsx)$'; then
  node scripts/perf-gate.mjs --hook || exit 1
fi

# Una hoja por sucursal en el PDF del Corte Z: sólo si el commit toca el archivo
# que lo arma. Renderiza el documento con el motor de Node y CUENTA las páginas.
#
# Existe porque el requisito se rompió TRES veces el 2026-08-12 —el bloque de
# comprobaciones, después un único renglón de veredicto que se pasó solo, y de
# nuevo el aviso del total— y las tres las encontró el usuario abriendo el
# archivo. El alto de una hoja no se lee en el código: se mide. ~2s, sin red.
if git diff --cached --name-only | grep -q '^src/utils/corteZPrint\.js$'; then
  node scripts/corte-z-una-hoja.mjs || exit 1
fi

# La FORMA de los anexos que se presentan a Hacienda: sólo si el commit toca lo
# que los produce. Corre en ~1s y sin red.
#
# Existe porque el 2026-08-11 se descubrió, con un día de diferencia, que DOS de
# los anexos salían con una columna de menos, y en los dos la que sobraba estaba
# en el medio: corría toda la fila y los montos caían en casillas equivocadas
# —las ventas gravadas se declaraban como exportaciones, y el total terminaba
# dentro de la casilla del DUI del cliente—. Ninguna prueba contaba las
# columnas, y el verificador contra el archivo del origen no podía verlo porque
# ese archivo tiene la misma forma vieja.
ANEXOS=$(git diff --cached --name-only | grep -E \
  'src/views/contabilidad/LibrosIvaView.jsx|supabase/functions/_shared/anexo-spec.json|tests/unit/anexoColumnas.test.js' || true)
if [ -n "$ANEXOS" ]; then
  npx vitest run tests/unit/anexoColumnas.test.js --reporter=dot || exit 1
fi

# bundle-gate NO va acá a propósito: necesita `npm run build` (~6 s) y un dist/
# fresco, y un hook que obliga a buildear en cada commit se termina saltando con
# --no-verify. Va antes de cerrar un trabajo, junto a gate:design.
#
# El BARRIDO MÓVIL tampoco: son ~16 minutos (37 rutas más sus pestañas internas)
# y necesita la app levantada con sesión. Es la capa que ve lo que ningún gate
# estático puede —desborde, blancos de 44pt, una vista que revienta— y va al
# cerrar una vista nueva, con el checklist de docs/CHECKLIST-VISTA-NUEVA.md:
#   E2E_BASE_URL=http://localhost:4174 npx playwright test \
#     --project=webkit-movil -g "todas las vistas"
# Para una sola vista, en veinte segundos: `-g foco` con RUTAS=mi-ruta.
