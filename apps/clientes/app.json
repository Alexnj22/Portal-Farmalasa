      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icono-adaptativo.png"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/icono.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#981D97",
          "mode": "production"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Puntos Salud usa Face ID para que sólo tú veas tu saldo y tu código."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icono.png",
          "imageWidth": 150,
          "backgroundColor": "#F5F4F8",
          "dark": {
            "image": "./assets/icono.png",
            "backgroundColor": "#0A090E"
          }
        }
      ],
      "./plugins/ciclo-por-escenas",
      "@bacons/apple-targets",
      "@sentry/react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Puntos Salud usa tu ubicación sólo mientras ves «Nuestras sucursales», para mostrarte primero la más cercana. No se guarda ni se envía.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": "Puntos Salud usa el movimiento del teléfono para que el brillo de tu tarjeta siga la inclinación. No se guarda ni se envía.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Puntos Salud usa tus fotos sólo cuando eliges una: la de tu receta para reservar, una foto para el chat con la farmacia o tu foto de perfil.",
          "cameraPermission": "Puntos Salud usa la cámara sólo cuando tú la abres, para tomar la foto de tu receta, una foto para el chat con la farmacia o tu foto de perfil.",
          "microphonePermission": "Puntos Salud usa el micrófono sólo para grabar las notas de voz que mandas en el chat con la farmacia."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Puntos Salud usa el micrófono sólo para grabar las notas de voz que mandas en el chat con la farmacia.",
          "recordAudioAndroid": true
        }
      ]
