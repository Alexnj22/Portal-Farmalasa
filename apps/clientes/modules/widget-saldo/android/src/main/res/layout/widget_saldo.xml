<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews: sólo FrameLayout/LinearLayout/TextView/ImageView. Los textos
     de muestra son los de la vista previa del selector de widgets (como el
     `placeholder` de iOS); `SaldoWidget.vista` los reemplaza.

     El material (2026-10-14): `fondo_material` lleva la lámina del nivel
     (drawable-nodpi/widget_material_*.png, los mismos shaders de la tarjeta) y
     `velo` la oscurece arriba y abajo. Sin material quedan ocultos y se ve el
     degradado de `widget_fondo`, como antes. `clipToOutline` redondea la
     imagen con las esquinas del fondo (Android 12+; antes queda en ángulo). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/raiz"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_fondo"
  android:clipToOutline="true">

  <ImageView
    android:id="@+id/fondo_material"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="centerCrop"
    android:importantForAccessibility="no"
    android:visibility="gone" />
  <ImageView
    android:id="@+id/velo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="fitXY"
    android:src="@drawable/widget_velo"
    android:importantForAccessibility="no"
    android:visibility="gone" />

  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

  <LinearLayout
    android:id="@+id/con_datos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <ImageView
        android:id="@+id/logo"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="6dp"
        android:src="@drawable/widget_logo"
        android:importantForAccessibility="no"
        android:visibility="gone" />
      <TextView
        android:id="@+id/marca"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="PUNTOS SALUD"
        android:textColor="#CCFFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:maxLines="1"
        android:ellipsize="end"
        android:shadowColor="#59000000"
        android:shadowDy="1"
        android:shadowRadius="2" />
      <TextView
        android:id="@+id/sello_team"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/widget_sello_team"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:text="TEAM"
        android:textColor="#CC1F142E"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"
        android:maxLines="1"
        android:visibility="gone" />
      <TextView
        android:id="@+id/nombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TU NOMBRE"
        android:textColor="#CCFFFFFF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:maxWidth="140dp" />
      <LinearLayout
        android:id="@+id/nivel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
          android:id="@+id/nivel_tipo"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="CLIENTE"
          android:textColor="#CCFFFFFF"
          android:textSize="7.5sp"
          android:textStyle="bold"
          android:letterSpacing="0.2"
          android:maxLines="1"
          android:shadowColor="#59000000"
          android:shadowDy="1"
          android:shadowRadius="2" />
        <TextView
          android:id="@+id/rotulo"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="ORO"
          android:textColor="#FFFFFF"
          android:textSize="13sp"
          android:textStyle="bold"
          android:letterSpacing="0.15"
          android:maxLines="1"
          android:shadowColor="#59000000"
          android:shadowDy="1"
          android:shadowRadius="2" />
      </LinearLayout>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <TextView
      android:id="@+id/dolares"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="$4.20"
      android:textColor="#FFFFFF"
      android:textSize="32sp"
      android:fontFamily="sans-serif-black"
      android:maxLines="1"
      android:autoSizeTextType="uniform"
      android:autoSizeMinTextSize="18sp"
      android:autoSizeMaxTextSize="36sp"
      android:shadowColor="#59000000"
      android:shadowDy="1"
      android:shadowRadius="3" />
    <TextView
      android:id="@+id/puntos"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="420 puntos"
      android:textColor="#D9FFFFFF"
      android:textSize="13sp"
      android:textStyle="bold"
      android:shadowColor="#59000000"
      android:shadowDy="1"
      android:shadowRadius="2" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

    <TextView
      android:id="@+id/pie"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="✓ Listo para canjear"
      android:textColor="#8FC20F"
      android:textSize="11sp"
      android:textStyle="bold"
      android:maxLines="1"
      android:ellipsize="end"
      android:shadowColor="#59000000"
      android:shadowDy="1"
      android:shadowRadius="2" />
  </LinearLayout>

  <LinearLayout
    android:id="@+id/sin_datos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="PUNTOS SALUD"
      android:textColor="#CCFFFFFF"
      android:textSize="10sp"
      android:textStyle="bold"
      android:letterSpacing="0.15" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Abre la app para ver tu saldo"
      android:textColor="#FFFFFF"
      android:textSize="15sp"
      android:textStyle="bold" />
  </LinearLayout>
  </FrameLayout>
</FrameLayout>
