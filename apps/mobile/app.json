{
  "expo": {
    "name": "Farmalasa",
    "slug": "farmalasa",
    "scheme": "farmalasa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icono.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lat.farmasalud.portal",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSUserActivityTypes": [
          "INSendMessageIntent"
        ]
      },
      "entitlements": {
        "com.apple.developer.usernotifications.communication": true,
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "appleTeamId": "ZZWA3Q7Q35"
    },
    "android": {
      "package": "lat.farmasalud.portal",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/icono.png"
      }
    },
    "web": {
      "favicon": "./assets/icono.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Farmalasa usa Face ID para que entres sin escribir tu contraseña."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Farmalasa usa Face ID para que entres sin escribir tu contraseña."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8E1F8F",
          "mode": "production"
        }
      ],
      "@bacons/apple-targets",
      [
        "expo-camera",
        {
          "cameraPermission": "Farmalasa usa la cámara para escanear el código de las cajas de traslado y de los productos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Farmalasa usa tus fotos para adjuntar la evidencia de una solicitud (producto dañado, boleta).",
          "cameraPermission": "Farmalasa usa la cámara para escanear cajas y fotografiar la evidencia de una solicitud."
        }
      ],
      "./plugins/ciclo-por-escenas"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5ee44446-9513-4ab9-b738-761a6d550187"
      }
    },
    "owner": "farmasalud"
  }
}
