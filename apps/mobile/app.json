{
  "expo": {
    "name": "Farmalasa",
    "slug": "farmalasa",
    "scheme": "farmalasa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icono.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/icono.png"
      }
    },
    "web": {
      "favicon": "./assets/icono.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
