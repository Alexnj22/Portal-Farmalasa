{
  "expo": {
    "name": "Farmalasa",
    "slug": "farmalasa",
    "scheme": "farmalasa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icono.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lat.farmasalud.portal",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "lat.farmasalud.portal",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/icono.png"
      }
    },
    "web": {
      "favicon": "./assets/icono.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5ee44446-9513-4ab9-b738-761a6d550187"
      }
    },
    "owner": "farmasalud"
  }
}
