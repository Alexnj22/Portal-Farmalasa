+  // 5b. Notas de crédito → a qué factura corrigen (2026-10-09).
+  //
+  // Hasta hoy no llegó ninguna NC de venta (sólo COF y CCF), pero cuando llegue
+  // el motor de puntos tiene que quitarle a ESE cliente los puntos de la parte
+  // acreditada, y para eso hace falta saber qué factura corrige. El DTE lo dice
+  // en `documentoRelacionado[].numeroDocumento` (con tipoGeneracion 2 es el
+  // codigo_generacion de la factura original); la base lo resuelve a un id
+  // (trigger de `ventas_nota_credito`).
+  //
+  // Sólo en documentos NUEVOS (o en una reparación con forceItems): la relación
+  // de una NC no cambia, y escribirla cada minuto sería churn.
+  //
+  // No aborta la corrida: si falla (p. ej. la tabla todavía no existe porque la
+  // función se desplegó antes que la migración) queda en el log y la venta ya
+  // está guardada. Lo que no se ligue, el motor no lo descuenta — y eso se ve.
+  const notas: any[] = [];
+  for (const venta of ventas) {
+    const erpId_s = String(venta.id_factura);
+    if (!newErpIds.has(erpId_s) && !forceItems) continue;
+    const invoiceId = invoiceIdMap.get(erpId_s);
+    if (!invoiceId) continue;
+    const rel = relacionDeNota(venta);
+    if (!rel) continue;
+    notas.push({ nc_invoice_id: invoiceId, codigo_relacionado: rel.numero, tipo_generacion: rel.tipoGeneracion });
+  }
+  if (notas.length > 0) {
+    const { error: ncErr } = await supabase
+      .from('ventas_nota_credito')
+      .upsert(notas, { onConflict: 'nc_invoice_id' });
+    if (ncErr) console.error(`[notas-credito] sucursal ${branchId}: ${notas.length} sin ligar — ${ncErr.message}`);
+  }
