+/**
+ * Una nota de crédito y la factura que corrige.
+ *
+ * Es nota de crédito si el sufijo del correlativo lo dice (NC/NCR/NCE) o si el
+ * origen manda el tipo de DTE '05'. La referencia se busca primero con la forma
+ * del DTE (`documentoRelacionado[0].numeroDocumento`) y después con los nombres
+ * planos que podría usar el listado del origen: el formato real de una NC en
+ * `descarga_dte_emitidos_json.php` todavía no se vio, así que se aceptan las
+ * variantes y lo que no traiga referencia simplemente no se liga.
+ */
+const SUFIJOS_NC = new Set(['NC', 'NCR', 'NCE']);
+function relacionDeNota(venta: any): { numero: string; tipoGeneracion: number | null } | null {
+  const tipoDte = String(venta?.tipo_dte ?? venta?.tipoDte ?? venta?.identificacion?.tipoDte ?? '');
+  const sufijo = parseTipoDoc(String(venta?.correlativo ?? '')).toUpperCase();
+  if (tipoDte !== '05' && !SUFIJOS_NC.has(sufijo)) return null;
+  const dr = venta?.documentoRelacionado ?? venta?.documento_relacionado;
+  const primero = Array.isArray(dr) ? dr[0] : (dr && typeof dr === 'object' ? dr : null);
+  const numero = primero?.numeroDocumento ?? primero?.numero_documento
+    ?? (typeof dr === 'string' ? dr : null)
+    ?? venta?.codigo_relacionado ?? venta?.codigo_generacion_relacionado ?? null;
+  if (numero == null || String(numero).trim() === '') return null;
+  const tg = Number(primero?.tipoGeneracion ?? primero?.tipo_generacion);
+  return { numero: String(numero).trim().toUpperCase(), tipoGeneracion: Number.isFinite(tg) ? tg : null };
+}
