<?xml version="1.0" encoding="UTF-8"?>
<!--
  Corrida diaria de fichas de clientes · 21:30 hora de El Salvador.

  Una hora antes del barrido de facturas (`regularizar-dte`, 22:30 SV) para que
  el barrido encuentre las fichas ya corregidas. Si la Mac está dormida a esa
  hora, launchd la ejecuta al despertar — por eso NO se usa `StartInterval`:
  con `StartCalendarInterval` una corrida perdida se recupera sola.

  Se instala con `npm run fichas:instalar-cron`, que copia este plist a
  ~/Library/LaunchAgents y el script a ~/Library/Application Support/farmalasa.

  El script NO se ejecuta desde el repo a propósito: macOS no deja que launchd
  corra un archivo dentro de ~/Documents ("Operation not permitted", TCC) y el
  agente muere antes de la primera línea. Leer Documents sí puede, así que la
  copia en Library trabaja contra el repo sin problema.

  No se edita la copia: se edita el original en el repo y se reinstala.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.farmalasa.fichas-clientes</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/alexnunez/Library/Application Support/farmalasa/corrida-diaria.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>21</integer>
    <key>Minute</key><integer>30</integer>
  </dict>

  <!-- El script ya escribe su propio log con fecha; esto es solo la red por si
       algo falla ANTES de que el script llegue a redirigir. -->
  <key>StandardOutPath</key>
  <string>/Users/alexnunez/Documents/Portal-Farmalasa/scripts/migracion-clientes/logs/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/alexnunez/Documents/Portal-Farmalasa/scripts/migracion-clientes/logs/launchd.err</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
